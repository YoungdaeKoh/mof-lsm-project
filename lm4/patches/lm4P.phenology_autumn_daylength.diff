+  real    :: decl, dayl ! solar declination (radian) and day length (hours), for the autumn rule
+  logical :: shortening ! true when days are getting shorter at this latitude
+  real, parameter :: pi_ = 3.14159265358979
 
+  ! day length from latitude and day of year (Cooper 1969 declination, sunrise
+  ! equation); days shorten when lat*d(decl)/dt < 0, i.e. after the local solstice
+  decl = 23.44*pi_/180.0 * sin(2.0*pi_*(284.0+doy)/365.0)
+  dayl = 24.0/pi_ * acos(max(-1.0, min(1.0, -tan(lat)*tan(decl))))
