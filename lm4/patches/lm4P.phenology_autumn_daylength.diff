+subroutine vegn_phenology_ppa(tile, lat, doy)
   type(land_tile_type), intent(inout) :: tile
+  real,    intent(in) :: lat ! latitude of the tile, radian (for the autumn day-length rule)
+  integer, intent(in) :: doy ! day of year, 1..365
 
