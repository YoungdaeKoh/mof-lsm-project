 &atmos_co2_nml
       do_co2_restore = .true.              ! EMISSION-DRIVEN = .false. 
       restore_tscale = 3.1536e7,
       restore_klimit = 1000                ! jgj resolution dependent so set to large number for now
       co2_radiation_override = .false.
       do_co2_emissions = .false.
/

 &atmos_model_nml
         nxblocks = 1
         nyblocks = 4
/

 &atmos_tracer_driver_nml
      step_update_tracer = .true.
      do_esm_nitrogen_flux = .true. !turn on nh4,no3 exchange with OCN
      prevent_flux_through_ice = .true. !set to .true. im 922
      do_nh3_atm_ocean_exchange = .true. !turn on exchange of NH3
      do_cmip6_bug_diag = .false.
/

 &atmos_tracer_utilities_nml
        scale_aerosol_wetdep = 1.
        drydep_exp = .true.
        kbs_val = 0.1
        file_dry = 'depvel_gc_am3_tran.nc',
	use_albedo_for_drydep = .true.
/

 &atmos_tropopause_nml
        do_tropopause_diagnostics = .true.
/

 &atmosphere_nml

/

 &cana_nml
       turbulence_to_use = 'ghannam2022'
       roughness_to_use  = 'ghannam2022'
       usfc_to_use       = 'ghannam2022'

       cd_leaf = 0.15
       usfc_factor = 0.5
       max_wind_decay = 6.0
       min_wind_decay = 0.5
       init_co2 = 286.0e-6
       canopy_air_mass             = 10.0
       canopy_air_mass_for_tracers = 10.0
       use_sai_for_heat_exchange = .TRUE.
       soil_resistance_to_use = 'HO2013'
       do_fog = .TRUE.
       fog_form_rate = 0.1
       fog_diss_time = 1800
       stable_rsl_factor = 0.1
       k_over_B = 0.0
/

 &carbon_aerosol_nml
      do_dynamic_bc = .true.,
      frac_bcbb_phobic = 0.4,
      frac_bcbb_philic = 0.6,
      do_dynamic_om = .true.,
      bcff_source = 'gocart_2007',
        bcff_input_name(1)='anthro',
        bcff_filename='merged_anthro_emissions.bc.0.5x0.5.1850.nc',
        bcff_time_dependency_type='fixed_year',bcff_dataset_entry=1850,1,1,0,0,
      omff_source = 'gocart_2007',
        omff_input_name(1)='anthro',
        omff_filename='merged_anthro_emissions.om.0.5x0.5.1850.nc',
        omff_time_dependency_type='fixed_year',omff_dataset_entry=1850,1,1,0,0,
      omsh_source = '',
      bcsh_source = '',
      bcav_source = 'do_aircraft'
        bcav_input_name(1)='fuel',
        bcav_filename='emissions.aircraft.aero.0.5x0.5.1850.nc',
        bcav_time_dependency_type='fixed_year',bcav_dataset_entry=1850,1,1,0,0,
      bcbb_source = 'BBEMIS2D',
        bcbb_filename='emissions2Dbb.bc.0.25x0.25.1850.nc',
        bcbb_input_name(1)='bb_surf',
        bcbb_time_dependency_type='fixed_year',bcbb_dataset_entry=1850,1,1,0,0,
      ombb_source = 'BBEMIS2D',
        ombb_filename='emissions2Dbb.om.0.25x0.25.1850.nc',
        ombb_input_name(1)='bb_surf',
        ombb_time_dependency_type='fixed_year',ombb_dataset_entry=1850,1,1,0,0,
      omna_source = '',
      omss_source = 'Gantt'
      omss_input_name = 'CHL1' 
      omss_coef = 11.
      omss_filename = 'regrid_ocn_Chl_globcolor_stock_fill0.nc'
      frac_om_philic_ocean  = 0.
      no_biobur_if_no_pbl = .false.
      do_biobur_pbl_bug = .false.
      use_bb_plumerise = .true.
/

 &cg_drag_nml
        cg_drag_freq = 1800,
        cg_drag_offset = 0,
        Bt_0 =  0.004,
        Bt_aug= 0.000,
        Bt_nh= -0.0005,
        Bt_sh= -0.0005,
        Bt_eq=  0.000,
        Bt_eq_width= 4.0,
        phi0n =  30.,
        phi0s = -30.,
        dphin =  5.0,
        dphis = -5.0,
        dump_flux= .true.
        dc= 2.4,
        cmax= 99.6
        do_conserve_energy = .true.,
/

 &cloud_generator_nml
      do_inhomogeneous_clouds = .true.
      defaultOverlap = 4
      overlapLengthScale = 2.0
/

 &cloud_rad_nml
        do_brenguier = .false.,
        scale_factor = 1.00
        rain_in_cloudrad = .true.
        snow_in_cloudrad = .true.
/

 &cloud_spec_nml
        cloud_type_form = 'stratuw'
	do_stochastic_clouds = .true.
	use_cloud_tracers_in_radiation = .false. !from radiation in common.nml
/

 &cloudrad_diagnostics_nml
      do_isccp = .true.
      isccp_scale_factor = 1.00
      water_ice_ratio = 10.
/

 &cloudrad_package_nml
      microphys_form = 'predicted'
/

 &clouds_nml
      do_zonal_clouds = .false.,
      do_obs_clouds  = .false.
/

 &convection_driver_nml
        cmt_mass_flux_source='uw',
        do_cmt=.true., 
        do_donner_before_uw = .false.,
        do_donner_conservation_checks = .false.,
        do_gust_cv = .false.,
        do_gust_cv_new = .false.,
        do_limit_donner = .false.,
        do_limit_uw = .false.,
        force_donner_moist_conserv = .false.,
        detrain_liq_num = .true.,
        detrain_ice_num = .true.,
/

 &coupler_nml
        months = 0,
        days   = 1,
        current_date = 1,1,1,0,0,0,
        calendar = 'NOLEAP'
        dt_atmos = 1800,
        dt_cpld  = 3600,
        use_lag_fluxes = .true.
        concurrent = .true.
        do_ocean = .true.
        ocean_npes = 24
        atmos_npes = 24
        atmos_nthreads = 1
        use_hyper_thread= .false.
/

 &cu_mo_trans_nml
      transport_scheme='diffusive'
      diff_norm = 2.5
/

 &damping_driver_nml
        trayfric = 0.,
        nlev_rayfric = 1,
        do_mg_drag = .false.
        do_cg_drag = .true.
        do_topo_drag = .true.,
        do_conserve_energy = .true.,
        kstart= 0
/

 &deep_conv_nml
        crh_th_ocean = 0.4
        crh_th_land  = 0.4
        auto_th0_d = 0.2e-3
        tcrit_d    = -25.15,
        peff_l_d   = 6.0e-5
        peff_i_d   = 13.e-5
        rkm_dp1 = 1.1
        rkm_dp2 = 0.1
        crh_max = 1.0
        cwfn_th = 10.
        tau_dp = 28800.
        mixing_assumption_d = 6
        do_ppen_d  = .true.
        rpen_d     = 4.0
        do_pevap_d = .true.
        cfrac_d    = 0.15
        hcevap_d   = 0.85
        hcevappbl_d = 0.95
        pblfac_d   = 1.0
        frac_limit_d = 0.25
        dcwfndm_th = 100
        lofactor_d = 1.0
        do_cgust_dp  = .true.
        cgust_choice = 1
        include_emf_d = .false.
/

 &diag_cloud_nml
      linvers = .false., lcnvcld = .false.,
      l_theqv = .true., lomega = .true.,
