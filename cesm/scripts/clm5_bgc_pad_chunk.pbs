#!/bin/bash
#PBS -N clm5_bgc_pad
#PBS -q workq
#PBS -l select=1:ncpus=48:mpiprocs=48:host=climate02
#PBS -j oe
#PBS -o /home/ydkoh/CESM/cases/clm5_bgc_pad/chunk.log
#
# One 10-year chunk of the CLM5-BGC post-AD spin-up (spinup_state=0).
#
# Differs from the AD script in one place: the first chunk must run with
# CONTINUE_RUN=FALSE so that CLM reads finidat -- the AD case's final restart at
# year 0211 -- and rescales the accelerated soil carbon and nitrogen pools back
# to their normal turnover. Every chunk after that continues from rpointer, so
# the driver passes FIRST=0 and the run switches to CONTINUE_RUN=TRUE.
#
# case.submit --no-batch exits 1 even on success, so its exit code is not a
# success test; the driver checks that the restart year advanced instead.
set -u
export PERL5LIB=/home/ydkoh/perl5/lib/perl5${PERL5LIB:+:$PERL5LIB}

CASE=/home/ydkoh/CESM/cases/clm5_bgc_pad
RUN=/data2/ydkoh/cesm2_output/clm5_bgc_pad/run
ARCH=/home/ydkoh/CESM/spinup_raw/clm5_BGC_PAD

CHUNK_N=${CHUNK_N:-10}
FIRST=${FIRST:-0}

cd "$CASE" || exit 1
if [ "$FIRST" = "1" ]; then
  ./xmlchange CONTINUE_RUN=FALSE           # read finidat, rescale the AD pools
else
  ./xmlchange CONTINUE_RUN=TRUE
fi
./xmlchange STOP_OPTION=nyears,STOP_N=$CHUNK_N
./xmlchange REST_OPTION=nyears,REST_N=1
./xmlchange RESUBMIT=0,DOUT_S=FALSE

echo "=== START $(date) on $(hostname)  FIRST=$FIRST CHUNK_N=$CHUNK_N ==="
cat "$RUN/rpointer.lnd" 2>/dev/null
./case.submit --no-batch
echo "=== MODEL PHASE DONE $(date) ==="
cat "$RUN/rpointer.lnd" 2>/dev/null

# Raw preservation: no --delete, so the archive only ever grows.
mkdir -p "$ARCH"
shopt -s nullglob
rsync -a "$RUN"/*.clm2.r.*.nc "$RUN"/*.clm2.h0.*.nc "$RUN"/rpointer.* "$ARCH/" 2>/dev/null
shopt -u nullglob
echo "=== archived -> $ARCH ($(ls "$ARCH"/*.clm2.r.*.nc 2>/dev/null | wc -l) restarts) $(date) ==="
echo "=== END $(date) ==="
