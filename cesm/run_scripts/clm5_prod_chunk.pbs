#!/bin/bash
#PBS -N clm5_prod
#PBS -q workq
#PBS -l select=1:ncpus=48:mpiprocs=48:host=climate01
#PBS -j oe
#PBS -o /home/ydkoh/CESM/cases/clm5_prod_1979_2023/chunk.log
#
# One chunk of the CLM5 production run 1979-2023.
#
# The driver (clm5_prod_chain.sh) decides how long the chunk is and whether it
# is the first; this script runs one chunk and archives it.
#
# FIRST=1 means CONTINUE_RUN=FALSE, so CLM reads finidat -- the post-AD final
# restart.  Every later chunk continues from rpointer.
#
# case.submit --no-batch exits 1 even on success, so its exit code is not a
# success test; the driver checks that the restart year advanced instead.
#
# Node: climate01.  climate00 is the login node and climate02 is often taken by
# other users, so a single 48-core node is the ceiling here.
set -u
export PERL5LIB=/home/ydkoh/perl5/lib/perl5${PERL5LIB:+:$PERL5LIB}

CASE=/home/ydkoh/CESM/cases/clm5_prod_1979_2023
RUN=/data2/ydkoh/cesm2_output/clm5_prod_1979_2023/run
ARCH=/home/ydkoh/CESM/spinup_raw/clm5_PROD

CHUNK_N=${CHUNK_N:-5}
FIRST=${FIRST:-0}

cd "$CASE" || exit 1

# hostfile from the PBS allocation -- the launch always goes where the
# allocation is (the case's env_mach_specific.xml points at this file).
awk '{c[$1]++} END {for (h in c) print h":"c[h]}' "$PBS_NODEFILE" > "$CASE/mpi.hosts"
echo "=== allocation ($PBS_NODEFILE) -> mpi.hosts ==="
cat "$CASE/mpi.hosts"

if [ "$FIRST" = "1" ]; then
  ./xmlchange CONTINUE_RUN=FALSE           # read finidat
else
  ./xmlchange CONTINUE_RUN=TRUE
fi
./xmlchange STOP_OPTION=nyears,STOP_N=$CHUNK_N
./xmlchange REST_OPTION=nyears,REST_N=1
./xmlchange RESUBMIT=0,DOUT_S=FALSE

echo "=== START $(date) on $(hostname)  FIRST=$FIRST CHUNK_N=$CHUNK_N ==="
cat "$RUN/rpointer.lnd" 2>/dev/null
./case.submit --no-batch
echo "=== MODEL PHASE DONE $(date) ==="
cat "$RUN/rpointer.lnd" 2>/dev/null

# Raw preservation: no --delete, so the archive only ever grows.
mkdir -p "$ARCH"
shopt -s nullglob
rsync -a "$RUN"/*.clm2.r.*.nc "$RUN"/*.clm2.h0.*.nc "$RUN"/rpointer.* "$ARCH/" 2>/dev/null
shopt -u nullglob
echo "=== archived -> $ARCH ($(ls "$ARCH"/*.clm2.r.*.nc 2>/dev/null | wc -l) restarts) $(date) ==="
echo "=== END $(date) ==="
