&JULES_DRIVE

  l_imogen = .false.

  diff_frac_const = 0.4
  t_for_snow      = 274.0
  t_for_con_rain  = 293.15

! WFDE5 v3.0, 1 deg (CDO conservative remap of the 0.5 deg CLM-format files,
! jules/scripts/wfde5_cdo_1deg.pbs).  One file per year, all seven variables.
!
! ** Time stamp **  WFDE5 records are 6-hourly MEANS stamped at the MIDPOINT of
! their window (03/09/15/21Z).  JULES wants a centred average to be given the
! time of the START of the averaging period (temporal-interpolation docs), so
! data_start is 00:00 and interp is 'nc' (hold constant, centred).  Using 'nf'
! here -- correct for the 3-hourly GSWP3 set, whose stamps are at period start
! -- would shift the diurnal cycle by three hours.
  data_start  = "1981-01-01 00:00:00"
! data_end is one record past the cycling window: JULES reads one record
! ahead, so a run ending 2011-01-01 00:00 must be able to open that record
! (2010 stopped with "Cannot advance to 2011-01-01 00:00:00" otherwise).
  data_end    = "2011-01-01 06:00:00"
  data_period = 21600

! Nearest-neighbour filled copy (jules/scripts/wfde5_nnfill_1deg.sh): 406 JULES
! land cells on coasts/islands have no WFDE5 value after the remap; the filled
! cells are listed in jules_wfde5_gapcells_1deg.nc in the same directory.
  file = "/data2/ydkoh/jules_wfde5_1deg_nnfill/wfde5_1deg_%y4.nc"

  nvars    = 7
  var      = 't',     'q',     'pstar', 'wind',  'lw_down', 'sw_down', 'precip'
  var_name = 'TBOT',  'QBOT',  'PSRF',  'WIND',  'FLDS',    'FSDS',    'PRECTmms'
  interp   = 'nc',    'nc',    'nc',    'nc',    'nc',      'nc',      'nc'

  z1_uv_in = 10.0
  z1_tq_in = 2.0

/
