  nvars = 12
  var(1)  = 'smc_tot'       output_type(1)  = 'M'
  var(2)  = 't_soil'        output_type(2)  = 'M'
  var(3)  = 'cs'            output_type(3)  = 'M'
  var(4)  = 'runoff'        output_type(4)  = 'M'
  var(5)  = 'latent_heat'   output_type(5)  = 'M'
  var(6)  = 'tstar_gb'      output_type(6)  = 'M'
  var(7)  = 'snow_mass_gb'  output_type(7)  = 'M'
  var(8)  = 'lai'           output_type(8)  = 'M'
  var(9)  = 'canht'         output_type(9)  = 'M'
  var(10) = 'cv'            output_type(10) = 'M'
  var(11) = 'gpp_gb'        output_type(11) = 'M'
  var(12) = 'npp_gb'        output_type(12) = 'M'
/
